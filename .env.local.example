# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real credentials.

# ── Local development ────────────────────────────────────────────────────────
# Used when DATABASE_URL is not set (i.e. normal local dev).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=quanttec

# ── Production (TiDB Cloud) ───────────────────────────────────────────────────
# Set this in Vercel's Environment Variables dashboard for production.
# Uncomment locally only if you want to test against the real prod database.
# DATABASE_URL=mysql://user:password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/test
