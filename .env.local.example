# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real credentials.

# ── Local development ────────────────────────────────────────────────────────
# Used when DATABASE_URL is not set (i.e. normal local dev).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=quanttec

# ── Production (TiDB Cloud) ───────────────────────────────────────────────────
# Set this in Vercel's Environment Variables dashboard for production.
# Uncomment locally only if you want to test against the real prod database.
# DATABASE_URL=mysql://user:password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/test

# ── Resend (transactional email) ──────────────────────────────────────────────
# Get an API key at https://resend.com/api-keys
# While using onboarding@resend.dev as the sender, Resend will only deliver
# to the email address that owns the Resend account. Verify a domain to send
# to anyone.
RESEND_API_KEY=re_your_api_key
RESEND_FROM="TMQS <onboarding@resend.dev>"
